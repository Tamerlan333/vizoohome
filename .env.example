# Not secrets (they appear in the browser):
NEXT_PUBLIC_SANITY_PROJECT_ID=7og6mqa4
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only. Needed ONLY if the dataset is private. Use a read-only (Viewer) token. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Draw-to-search map (MapTiler). The key appears in the browser, so RESTRICT it in MapTiler ("Allowed HTTP origins").
# Use a DEV key (http://localhost:3000) in .env.local and a separate PROD key (your domains) in the hosting settings. Never commit real keys.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional MapTiler style id (default: streets-v2)
NEXT_PUBLIC_MAP_STYLE=streets-v2
